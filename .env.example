# Database (Render provides this automatically when you attach a Postgres instance)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Dashboard login — pick any password, share it with your team
ADMIN_PASSWORD=changeme

# Webhook shared secret — set this same value in GHL's webhook config
WEBHOOK_SECRET=changeme

# Session encryption key — any random 32+ char string
SESSION_SECRET=changeme-use-a-long-random-string

# Port (Render sets this automatically)
PORT=3000
